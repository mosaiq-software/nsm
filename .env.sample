# === Identity / networking (per node) ===
PRODUCTION=true
NODE_ID=node-1
BIND_ADDRESS=192.168.1.206
RAFT_PORT=1027
API_PORT=1025

# === Cluster / VIP ===
VIP=192.168.1.240
VRRP_ROUTER_ID=51
VRRP_PASS=changeme
VRRP_IFACE=eth0
# Shared secret used to sign cluster join tokens and encrypt cert material at rest
CLUSTER_SECRET=please-change-me

# Bootstrap mode: "init" for the very first node of a new cluster, else leave empty and use --join
NSM_BOOTSTRAP=

# === Frontend / auth ===
FRONTEND_URL=https://nsm.mosaiq.dev
API_URL=https://api.nsm.mosaiq.dev
NSM_WWW_PATH=/var/lib/nsm/www

# === Data paths ===
DATABASE_DIR=/var/lib/nsm
DATABASE_NAME=nsmdb.sqlite
DATABASE_LOGGING=false
RAFT_DATA_DIR=/var/lib/nsm/raft
REPO_SANDBOX_PATH=/var/lib/nsm/sandbox
DEPLOYMENT_PATH=/nsm/apps
PERSISTENT_PATH=/media/drive3/nsm
NGINX_CONF_DIR=/etc/nsm/nginx
LETSENCRYPT_LIVE_DIR=/etc/letsencrypt/live

# === Git ===
GIT_SSH_KEY_DIR=/etc/nsm/.ssh
GIT_SSH_KEY_FILE=id_ed25519

# === GitHub OAuth ===
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/auth/github
GITHUB_OAUTH_CLIENT_ID=123
GITHUB_OAUTH_CLIENT_SECRET=123
GITHUB_OAUTH_DEFAULT_USER=Camo651

# === Self-update ===
# certbot DNS plugin command prefix, e.g. "--dns-cloudflare --dns-cloudflare-credentials /etc/nsm/cf.ini"
CERTBOT_DNS_ARGS=
# How NSM fetches its own new version artifact on self-update (git tag based by default)
NSM_REPO_DIR=/opt/nsm
