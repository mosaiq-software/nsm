# NSM node config. Copied to /etc/nsm/nsm.env by bootstrap.sh on first run.
#
# One file per node, shared by the daemon and the Vite UI build. Only VITE_-prefixed vars are
# exposed to the client bundle; everything else (secrets, cluster config) stays server-side.

# === Identity / role (per node) ===
PRODUCTION=true
NODE_ID=node-1
# 'leader' on exactly ONE machine (the DHCP-reserved one); 'follower' on all others.
NSM_ROLE=follower
# Fallback IP only; the authoritative current IP is auto-detected and registered at runtime.
BIND_ADDRESS=192.168.1.206
API_PORT=1025

# === Cluster ===
# The one stable anchor: base URL of the leader (give the leader machine a DHCP reservation).
# On the leader this can point at itself, e.g. http://127.0.0.1:1025
LEADER_ADDRESS=http://192.168.1.10:1025
# Internal DNS suffix; nodes are addressed as <nodeId>.<INTERNAL_DOMAIN> for IP-less routing.
INTERNAL_DOMAIN=nsm.internal
# Shared secret authenticating internal cluster RPCs (register/pull/status/self-update).
CLUSTER_SECRET=please-change-me

# === Frontend / auth ===
# The leader serves the management UI same-origin with the API. FRONTEND_URL is the public base
# URL of the leader; it is where the OAuth handshake redirects back to (with ?token=...).
FRONTEND_URL=https://nsm.mosaiq.dev
API_URL=https://nsm.mosaiq.dev
# Base URL followers use to reach this leader; baked into the served install.sh and the "Add a node"
# join command. Defaults to API_URL/FRONTEND_URL, else http://<BIND_ADDRESS>:<API_PORT>. Set this
# explicitly when the leader sits behind a TLS-terminating proxy on a different host/port.
# NSM_PUBLIC_URL=https://nsm.mosaiq.dev
# The built UI is served from here by the daemon; the leader's bootstrap builds into this path.
NSM_WWW_PATH=/var/lib/nsm/www

# === Deploys ===
# Zero-downtime (blue-green) deploys are ON by default: the new generation is brought up and
# health-gated alongside the old one, nginx is flipped only once it is ready, then the old
# generation is drained and torn down. Set to false to force legacy in-place recreation on this
# node (individual projects can also opt out). DEPLOY_DRAIN_MS is how long the old generation lingers
# after cutover; READINESS_* bound the health gate for the new generation.
ZERO_DOWNTIME_DEPLOYS=true
# DEPLOY_DRAIN_MS=10000
# READINESS_TIMEOUT_MS=120000
# READINESS_INTERVAL_MS=2000

# === Data paths ===
DATABASE_DIR=/var/lib/nsm
DATABASE_NAME=nsmdb.sqlite
DATABASE_LOGGING=false
REPO_SANDBOX_PATH=/var/lib/nsm/sandbox
DEPLOYMENT_PATH=/nsm/apps
PERSISTENT_PATH=/media/drive3/nsm
NGINX_CONF_DIR=/etc/nsm/nginx
LETSENCRYPT_LIVE_DIR=/etc/letsencrypt/live

# === Git ===
GIT_SSH_KEY_DIR=/etc/nsm/.ssh
GIT_SSH_KEY_FILE=id_ed25519

# === GitHub App (repo access) ===
# Preferred way to clone private app repos unattended. Create a GitHub App with Repository
# "Contents: Read-only", install it on the repos you deploy, and set the App id here. The App's
# private key (.pem) lives ONLY on the leader; paste it into the path below (chmod 600, owned by nsm).
# The leader mints short-lived installation tokens and serves them to followers on demand, so no
# machine-user account or long-lived credential is needed. Leave GITHUB_APP_ID empty to fall back to
# the shared SSH deploy key. Installation id is optional; it is auto-resolved per repo when empty.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/nsm/github-app.pem
GITHUB_APP_INSTALLATION_ID=

# === GitHub OAuth ===
# The daemon and the UI build share these VITE_-prefixed values (client id, callback, default
# user). The callback points at the leader's /auth/github (same origin as the UI). Only the
# client secret is server-only: it is never VITE_-prefixed, so it never reaches the client bundle.
VITE_GITHUB_OAUTH_CLIENT_ID=123
VITE_GITHUB_OAUTH_CALLBACK_URL=https://nsm.mosaiq.dev/auth/github
VITE_GITHUB_OAUTH_DEFAULT_USER=Camo651
GITHUB_OAUTH_CLIENT_SECRET=123

# === Observability ===
# Leader-side query proxy targets (the stack runs on the leader).
LOKI_URL=http://127.0.0.1:3100
PROMETHEUS_URL=http://127.0.0.1:9090
GRAFANA_URL=http://127.0.0.1:3000
# Where per-node agents ship logs (defaults to the leader host on :3100 if unset).
OBS_LOKI_PUSH_URL=http://192.168.1.10:3100

# === Self-update ===
# certbot DNS plugin command prefix, e.g. "--dns-cloudflare --dns-cloudflare-credentials /etc/nsm/cf.ini"
CERTBOT_DNS_ARGS=
NSM_REPO_DIR=/opt/nsm

# === Web Push notifications ===
# Background browser notifications for deploy events (fire even when the tab/Chrome is closed).
# Only the leader signs and sends push messages. By default the leader auto-generates a VAPID key
# pair on first run and persists it (regenerate later from the UI), so these usually stay empty.
# Set them only to pin a specific pair (e.g. shared across environments); pinned keys are
# authoritative and cannot be regenerated from the UI. Generate a pair with:
#   npx web-push generate-vapid-keys
# Web push requires the dashboard to be served over HTTPS in production (localhost is exempt for dev).
NSM_VAPID_PUBLIC_KEY=
NSM_VAPID_PRIVATE_KEY=
# Contact URI (mailto: or https:) included in push requests, per the VAPID spec.
NSM_VAPID_SUBJECT=mailto:admin@nsm.local
