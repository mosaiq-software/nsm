{
    "compilerOptions": {
        "target": "es2021",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": ["es2021"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts"]
}
