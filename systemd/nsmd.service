[Unit]
Description=NSM daemon (Node Server Manager node)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# The daemon is the `backend` workspace; deps are hoisted to /opt/nsm/node_modules.
WorkingDirectory=/opt/nsm/backend
EnvironmentFile=/etc/nsm/nsm.env
# Run tsx directly (no npm at runtime) so a broken/mismatched system npm can't take the daemon down.
ExecStart=/opt/nsm/node_modules/.bin/tsx src/index.ts
Restart=always
RestartSec=3
# nsmd runs on the host (no container) so it can drive docker/nginx/certbot. It runs as the
# unprivileged `nsm` user: the docker group covers container ops, and a scoped /etc/sudoers.d/nsm
# policy covers the few root-only commands (nginx reload, certbot, systemctl restart, /etc/hosts).
User=nsm
Group=nsm
SupplementaryGroups=docker
KillSignalRestart=SIGTERM
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
